    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/chip0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/title0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E7EAF2"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/pos0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:textColor="#8A93A8"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/days0" android:textColor="#FFB23E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:textSize="26sp" />
            <TextView
                android:id="@+id/unit0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="8dp"
                android:text="日"
                android:textColor="#8A93A8"
                android:textSize="12sp" />
            <Chronometer
                android:id="@+id/chrono0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:textColor="#FFB23E"
                android:textSize="18sp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp">
            <ProgressBar
                android:id="@+id/bar0_game"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_game"
                android:visibility="gone" />
<ProgressBar
                android:id="@+id/bar0_deadline"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_deadline"
                android:visibility="gone" />
<ProgressBar
                android:id="@+id/bar0_event"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_event"
                android:visibility="gone" />
<ProgressBar
                android:id="@+id/bar0_age"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_age"
                android:visibility="gone" />
<ProgressBar
                android:id="@+id/bar0_life"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_life"
                android:visibility="gone" />
<ProgressBar
                android:id="@+id/bar0_repeat"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_repeat"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
